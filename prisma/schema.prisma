generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  tenant    String   @unique
  createdAt DateTime @default(now())
}
model PropertyLead {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  propertyName String
  city         String
  propertyType String

  createdAt    DateTime @default(now())
}

model TripRequest {
  id          String   @id @default(cuid())
  destination String
  tripType    String
  startDate   DateTime
  endDate     DateTime
  travellers  String
  budget      String
  phone       String
  email       String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())
}
